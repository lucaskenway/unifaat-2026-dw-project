{
  "tags": [
    {
      "name": "Course",
      "description": "Operações relacionadas a cursos"
    }
  ],
  "paths": {
    "/courses": {
      "get": {
        "tags": ["Course"],
        "summary": "Listar todos os cursos",
        "description": "Retorna uma lista paginada de todos os cursos com seus usuários associados",
        "operationId": "listCourses",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Número da página (padrão: 1, mínimo: 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Quantidade de registros por página (padrão: 10, máximo: 20)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 20
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de cursos recuperada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer",
                      "example": 1
                    },
                    "limit": {
                      "type": "integer",
                      "example": 10
                    },
                    "total": {
                      "type": "integer",
                      "example": 25
                    },
                    "next": {
                      "type": "integer",
                      "nullable": true,
                      "example": 2
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Course"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Course"],
        "summary": "Criar um novo curso",
        "description": "Cria um novo curso com os dados fornecidos",
        "operationId": "createCourse",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "description": "Dados do curso a ser criado",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "professor"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Nome do curso",
                    "example": "JavaScript Avançado"
                  },
                  "professor": {
                    "type": "string",
                    "description": "Nome do professor",
                    "example": "Dr. João Silva"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Curso criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos ou incompletos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": ["name obrigatório!", "professor obrigatório!"]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/courses/{id}": {
      "get": {
        "tags": ["Course"],
        "summary": "Obter um curso específico",
        "description": "Retorna os detalhes de um curso específico pelo ID",
        "operationId": "getCourse",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do curso",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Curso encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            }
          },
          "404": {
            "description": "Curso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Course not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Course"],
        "summary": "Atualizar um curso",
        "description": "Atualiza os dados de um curso específico",
        "operationId": "updateCourse",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do curso",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "description": "Dados do curso a ser atualizado",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "professor"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Nome do curso",
                    "example": "JavaScript Avançado"
                  },
                  "professor": {
                    "type": "string",
                    "description": "Nome do professor",
                    "example": "Dr. João Silva"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Curso atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos ou incompletos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Name and professor are required"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Curso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Course not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Course"],
        "summary": "Deletar um curso",
        "description": "Remove um curso específico do banco de dados",
        "operationId": "deleteCourse",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do curso",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Curso deletado com sucesso"
          },
          "404": {
            "description": "Curso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Course not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID único do curso",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Nome do curso",
            "example": "JavaScript Avançado"
          },
          "professor": {
            "type": "string",
            "description": "Nome do professor responsável",
            "example": "Dr. João Silva"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Data de criação do curso",
            "example": "2026-05-21T14:30:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Data da última atualização",
            "example": "2026-05-21T14:30:00.000Z"
          },
          "users": {
            "type": "array",
            "description": "Usuários associados ao curso",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "example": 1
                },
                "name": {
                  "type": "string",
                  "example": "João"
                },
                "email": {
                  "type": "string",
                  "example": "joao@example.com"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token para autenticação"
      }
    }
  }
}
